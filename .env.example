# Owner backend
DATABASE_URL=sqlite:///./nail_system.db
# Creates the owner login ONLY when none exists yet (first start). Change it later in Salon Settings.
OWNER_BOOTSTRAP_PASSWORD=replace-with-a-long-random-secret
# Alternatively set OWNER_PASSWORD_HASH to an encoded scrypt value and omit bootstrap password.
OWNER_SESSION_TTL_MINUTES=480
OWNER_COOKIE_SECURE=false
STAFF_SESSION_TTL_MINUTES=720
OWNER_LOGIN_ATTEMPTS_PER_5_MINUTES=5
ALLOWED_ORIGINS=http://127.0.0.1:5501,http://localhost:5501

# Shared with the Check-In backend: Owner -> Check-In calls send it, and Check-In -> Owner reads
# (GET /internal/services) require it. Use the same long random value in both processes.
CHECKIN_INTERNAL_SERVICE_TOKEN=replace-with-a-separate-long-random-token
CHECKIN_API_BASE=http://127.0.0.1:8000

# Stable https origin that Twilio can reach (a Cloudflare Quick Tunnel URL is for development only).
PUBLIC_BASE_URL=https://example.invalid

# AI phone receptionist (Twilio Media Streams + OpenAI Realtime). Both switches default off in code.
VOICE_ENABLED=false
VOICE_ALLOW_REAL_CALLS=false
TWILIO_ACCOUNT_SID=ACreplace-me
TWILIO_AUTH_TOKEN=replace-with-a-secret
TWILIO_PHONE_NUMBER=+16025551234
OPENAI_API_KEY=replace-with-a-secret
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
VOICE_STREAM_TOKEN_TTL_SECONDS=120
VOICE_MAX_CALL_MINUTES=20
VOICE_TOOL_TIMEOUT_SECONDS=5
