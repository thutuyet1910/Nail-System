DATABASE_URL=sqlite:///./nail_system.db
# Browser origins allowed to call this API cross-origin. The Caddy setup serves the kiosk same-origin,
# so this is only needed if you serve the page from another origin. Never use a wildcard.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Must match the owner backend. Never expose this value to kiosk/browser JavaScript.
CHECKIN_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token
SALON_TIMEZONE=America/Phoenix

# Owner backend base URL (no trailing path). Check-In reads the service catalog from
# {OWNER_API_BASE}/internal/services using the token above. Server-side only.
OWNER_API_BASE=http://127.0.0.1:8001
# Optional: fresh cache seconds (default 45) and how long a last-good catalog may be
# served while the Owner is unreachable (default 300).
# OWNER_CATALOG_CACHE_SECONDS=45
# OWNER_CATALOG_MAX_STALE_SECONDS=300
